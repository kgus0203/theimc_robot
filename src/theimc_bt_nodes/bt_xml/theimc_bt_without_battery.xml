<!--
레일이 12개 있다고 가정하고 시나리오 테스트
(현재는 모든 레일의 위치가 같게 해놓음)

0. 이걸 켤 때 대략 홈 위치에서 출발한다고 가정
   ForEachRail로 대상 rail이 순차적으로 들어옴
1. /mission_trigger 토픽을 통해 미션 시작 신호를 받으면
   Nav2로 레일 앞까지 이동
2. 1이 성공했다면 아래 액션 실행
   ros2 action send_goal /rail_approach interfaces_pkg/action/RailApproach
   "{timeout_sec: 20.0, x_tolerance: 0.25, angle_tolerance: 5.0, allow_reverse_align: false}"
3. 레일에 정상적으로 올라가면 STM에서 ON_RAIL이 시리얼로 나옴
   레일에서 탈출하면 OUT_RAIL이 나옴
4. forward 전송 -> stop 전송 -> 대기
   -> back 전송 -> stop 전송 -> 대기
   -> back 전송하여 레일에서 탈출
   모든 명령은 /rail_command로 발행
5. STM에서 OUT_RAIL 수신
   -> 홈 위치로 이동
   -> 미션 종료

홈 위치와 레일 위치는 config/rails.yaml에서 관리

1번 레일:
x: -0.9062973260879517
y: -2.77840256690979
-->

<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence name="MissionWithReturnHome">

      <!-- config/rails.yaml에서 공통 홈 위치를 한 번 읽음 -->
      <GetLocationPose
        location="home"
        x="{home_x}"
        y="{home_y}"
        yaw="{home_yaw}"/>

      <!-- 초기 변수 설정 -->
      <SetBlackboard
        output_key="mission_return_mode"
        value="DIRECT"/>

      <SetBlackboard
        output_key="last_executed_index"
        value="0"/>

      <SetBlackboard
        output_key="return_mode"
        value="MISSION_COMPLETE"/>

      <!-- 다중 레일 미션 수행 -->
      <ForceSuccess>
        <Sequence name="MultiRailMission">

          <!-- 1. 미션 시작 신호 및 대상 레일 목록 대기 -->
          <WaitForMissionTrigger
            selected_rails="{selected_rails}"/>

          <!-- 2. 관제 복귀 요청 감시 -->
          <Inverter>
            <ReturnHomeRequested
              return_mode="{return_mode}"/>
          </Inverter>

          <!-- 3. 선택된 레일 순회 -->
          <ForEachRail
            rail_list="{selected_rails}"
            current_rail="{rail_id}"
            start_index="{last_executed_index}"
            last_executed_index="{last_executed_index}">

            <SubTreePlus
              ID="RailRoutine"
              rail_id="{rail_id}"
              mission_return_mode="{mission_return_mode}"
              __autoremap="1"/>

          </ForEachRail>

          <!-- 모든 레일 완료 후 홈 복귀 -->
          <GoToPose
            x="{home_x}"
            y="{home_y}"
            yaw="{home_yaw}"/>

          <SetBlackboard
            output_key="return_mode"
            value="MISSION_COMPLETE"/>

        </Sequence>
      </ForceSuccess>

      <!-- 외부 복귀 요청 처리 -->
      <Switch3
        variable="{return_mode}"
        case_1="EXIT_RAIL_HOME"
        case_2="REVERSE_HOME"
        case_3="DIRECT">

        <!-- Case 1: 레일 위에서 안전하게 탈출한 후 홈 복귀 -->
        <Sequence name="LeaveRailAndReturnHome">

          <PublishRailCommand command="BACK"/>

          <WaitForRailState
            state="OUT_RAIL"
            accept_stale="false"
            timeout_sec="30.0"/>

          <PublishRailCommand command="OUT"/>

          <WaitSeconds seconds="10.0"/>

          <DriveCmdVel
            linear_x="-0.25"
            angular_z="0.0"
            seconds="3.0"/>

          <SetBlackboard
            output_key="mission_return_mode"
            value="DIRECT"/>

          <GoToPose
            x="{home_x}"
            y="{home_y}"
            yaw="{home_yaw}"/>

        </Sequence>

        <!-- Case 2: 레일 접근 중 후진한 후 홈 복귀 -->
        <Sequence name="ReverseAndReturnHome">

          <DriveCmdVel
            linear_x="-0.25"
            angular_z="0.0"
            seconds="3.0"/>

          <SetBlackboard
            output_key="mission_return_mode"
            value="DIRECT"/>

          <GoToPose
            x="{home_x}"
            y="{home_y}"
            yaw="{home_yaw}"/>

        </Sequence>

        <!-- Case 3: 즉시 홈으로 이동 -->
        <GoToPose
          x="{home_x}"
          y="{home_y}"
          yaw="{home_yaw}"/>

        <!-- Default: 미션 완료 등 나머지 상태 -->
        <GoToPose
          x="{home_x}"
          y="{home_y}"
          yaw="{home_yaw}"/>

      </Switch3>

    </Sequence>
  </BehaviorTree>


  <BehaviorTree ID="RailRoutine">
    <Sequence name="RailRoutineSequence">

      <!-- 1. 레일 앞 위치로 이동 -->
      <SetBlackboard
        output_key="mission_return_mode"
        value="DIRECT"/>

      <GetRailPose
        rail_id="{rail_id}"
        x="{rail_x}"
        y="{rail_y}"
        yaw="{rail_yaw}"/>

      <GoToPose
        x="{rail_x}"
        y="{rail_y}"
        yaw="{rail_yaw}"/>

      <!-- 2. 레일 정밀 접근 -->
      <SetBlackboard
        output_key="mission_return_mode"
        value="REVERSE_HOME"/>

      <RailApproach
        timeout_sec="60.0"
        x_tolerance="0.25"
        angle_tolerance="3.0"
        allow_reverse_align="true"/>

      <PublishRailCommand command="ON"/>
      <WaitSeconds seconds="5.0"/>

      <!-- 3. 레일 진입 및 ON_RAIL 대기 -->
      <SetBlackboard
        output_key="mission_return_mode"
        value="EXIT_RAIL_HOME"/>

      <PublishRailCommand command="DETECTED"/>
      <WaitForRailState
        state="ON_RAIL"
        accept_stale="false"
        timeout_sec="20.0"/>

      <!-- 4. 레일 위 시나리오 동작 -->
      <PublishRailCommand command="FORWARD"/>
      <WaitSeconds seconds="5.0"/>

      <PublishRailCommand command="STOP"/>
      <WaitSeconds seconds="5.0"/>

      <PublishRailCommand command="BACK"/>
      <WaitSeconds seconds="5.0"/>

      <PublishRailCommand command="STOP"/>
      <WaitSeconds seconds="5.0"/>

      <!-- 5. 레일 탈출 및 OUT_RAIL 확인 -->
      <PublishRailCommand command="BACK"/>

      <WaitForRailState
        state="OUT_RAIL"
        accept_stale="false"
        timeout_sec="30.0"/>
      <PublishRailCommand command="OUT"/>
      <WaitSeconds seconds="5.0"/>

      <!-- 6. 레일에서 완전히 떨어지도록 추가 후진 -->
      <SetBlackboard
        output_key="mission_return_mode"
        value="REVERSE_HOME"/>

      <WaitSeconds seconds="10.0"/>

      <DriveCmdVel
        linear_x="-0.25"
        angular_z="0.0"
        seconds="3.0"/>

      <SetBlackboard
        output_key="mission_return_mode"
        value="DIRECT"/>

    </Sequence>
  </BehaviorTree>

</root>
